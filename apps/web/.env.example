# Copy to .env.local. Every variable is optional: without Supabase the app
# runs in demo mode (data stays in this browser).
# All of them are public (NEXT_PUBLIC_*): never put a secret in this file.
# Reference: docs/getting-started.md#environment-variables

# Supabase project (Project settings -> API keys). The publishable key is
# meant for browsers; row-level security and the RPCs protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy anon key works too (used when the above is empty)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sign-in methods offered, comma separated: email, google, github
# (empty: email only). E-mail links reach the public only once Supabase has
# its own SMTP server; until then list just the OAuth providers enabled in
# Supabase Auth, e.g. google,github. Demo mode always signs in by address.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Cloudflare Turnstile site key (bot check on sign-in). The matching secret
# goes into the Supabase Auth settings (CAPTCHA protection, provider Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Where the voxel city is served from (no trailing slash). `bun dev` uses
# the published city by default (.env.development); production builds use:
#   /city/flon                     bundled demo tiles (default)
#   /city/agglomeration            a local build of Lausanne and its 15 neighbours
#                                  (`geovox build --area agglomeration`) in public/city/agglomeration
#   /city/lausanne                 a local build of the municipality only
#   https://<project>.pages.dev    the production CDN (Cloudflare Pages)
# Tiles of format 1 (built before the colour model of ADR 0025) still render.
NEXT_PUBLIC_CITY_BASE_URL=

# Public URL of the deployment, for metadata and the sitemap
# (on Vercel the production URL is detected automatically)
NEXT_PUBLIC_SITE_URL=

# Contact address shown on the privacy and terms pages
# (falls back to the GitHub issues of the repository)
NEXT_PUBLIC_CONTACT_EMAIL=
