# Read by `bun dev` only (next dev). Public values, committed on purpose.
# The development server shows the published city (Lausanne and its 15
# neighbouring municipalities, served by Cloudflare Pages) instead of the
# small Flon demo that ships with the code. Production builds and the
# end-to-end tests keep the demo unless NEXT_PUBLIC_CITY_BASE_URL is set
# (on Vercel it is). Offline? Put NEXT_PUBLIC_CITY_BASE_URL=/city/flon in
# .env.local, which wins over this file.
NEXT_PUBLIC_CITY_BASE_URL=https://geolausanne-city.pages.dev
